{
  "identifier": "settings",
  "description": "Least-privilege surface for the settings window: window dragging, settings lifecycle and licence links.",
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-app-settings-info",
    "allow-app-settings-close",
    "allow-app-open-external",
    "allow-app-settings-open"
  ]
}
