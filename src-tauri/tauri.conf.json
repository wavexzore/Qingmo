{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qingmo",
  "version": "0.1.0",
  "identifier": "com.wavexzore.qingmo",
  "build": {
    "beforeDevCommand": "pnpm --filter @qingmo/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @qingmo/desktop build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "青墨",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'",
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "capabilities": ["default", "about"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdx"],
        "name": "Markdown",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "copyright": "Copyright 2026 Qingmo Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGOEVGMzU4Q0JDN0I4MDIKUldRQ3VNZkxXUE9PbjFCU2xPU2kxcmlHVVBjVkpPTEw2YUpVTzgvM1g3bHNxeCs4Qkh0TFZvYXIK",
      "endpoints": ["https://github.com/wavexzore/Qingmo/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
