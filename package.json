{
  "name": "qingmo",
  "version": "0.1.3",
  "private": true,
  "description": "Qingmo — local-first Markdown editor",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @qingmo/desktop dev",
    "build": "pnpm --filter @qingmo/desktop build",
    "preview": "pnpm --filter @qingmo/desktop preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:e2e": "pnpm --filter @qingmo/desktop build:e2e",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "ci:web": "pnpm typecheck:e2e && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm depcruise && pnpm format:check",
    "ci:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "ci:generated": "bash scripts/ci/check-generated.sh",
    "release:check-versions": "node scripts/release/check-versions.mjs",
    "release:check-notes": "node scripts/release/check-release-notes.mjs",
    "release:check-latest": "node scripts/release/check-latest-json.mjs",
    "release:make-latest": "node scripts/release/make-latest-json.mjs",
    "release:test-latest": "bash scripts/release/test-check-latest-json.sh",
    "release:test-make-latest": "bash scripts/release/test-make-latest-json.sh",
    "release:test-notes": "bash scripts/release/test-check-release-notes.sh",
    "release:test": "bash scripts/release/test-check-latest-json.sh && bash scripts/release/test-make-latest-json.sh && bash scripts/release/test-check-release-notes.sh",
    "release:local": "bash scripts/release/build-local.sh",
    "ci:negative": "bash scripts/ci/negative-contract.sh && bash scripts/ci/negative-capability.sh",
    "ci:local": "pnpm ci:web && pnpm ci:rust && pnpm ci:generated && pnpm ci:negative && pnpm test:e2e",
    "bench": "pnpm typecheck:bench && node bench/run.mjs",
    "bench:fixtures": "node bench/generate-fixtures.mjs",
    "typecheck:bench": "tsc -p bench/tsconfig.json --noEmit",
    "depcruise": "depcruise --config dependency-cruiser.config.cjs apps packages",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
